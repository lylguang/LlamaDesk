```
  test("只对 bash 降级：非 bash 权限即使 pattern 看起来像危险命令也照常放行", () => {
    const pattern = "rm -rf /tmp/x";
    expect(isDangerousCommand(pattern)).toBe(true); // 前提钉住：这串必须是危险命令
